# Copy to .env (same folder as docker-compose.yml) and fill in the values.
# .env holds secrets: never commit it.

# --- Database ---
POSTGRES_USER=postgres
# Required. Use letters, digits, - or _ only: it is placed inside DATABASE_URL, so
# characters like @ : / # would break the URL.
POSTGRES_PASSWORD=c927f0f6f31c503f7c98f4cbfcd5f835
POSTGRES_DB=muhaid
# Port on THIS machine (localhost only) for psql/TablePlus. 5433 is used by the dev database.
DB_HOST_PORT=5434

# --- Backend ---
# Required, at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=cd896bcaa9d5a11a87ee17a560ad0489ea40f3c134609967e7ba6ef4f0d7ad06
JWT_EXPIRES_IN=8h
# Exact address the BROWSER uses for the frontend (scheme + host + port).
CORS_ORIGIN=http://localhost:8081
BACKEND_HOST_PORT=3001

# --- First admin user (used only by: docker compose run --rm tools npm run db:seed) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@muhaid.local
ADMIN_PASSWORD=Admin_12345

# --- Frontend ---
# Address the BROWSER uses to reach the API (not "backend"). Baked in at build time:
# after changing it run: docker compose up -d --build frontend
VITE_API_URL=http://localhost:3001
FRONTEND_HOST_PORT=8081
